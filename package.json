{
  "name": "cyrus-panel",
  "version": "1.1.4",
  "description": "A modern, open-source server management panel for managing servers, nodes, containers, resources, and infrastructure.",
  "main": "src/index.js",
  "type": "commonjs",
  "scripts": {
    "dev": "NODE_ENV=development node src/index.js",
    "build:frontend": "cd frontend && npm install && npm run build && cd .. && rm -rf src/frontend && mkdir -p src/frontend && cp -r frontend/out/. src/frontend/",
    "build": "npm run build:frontend",
    "start": "NODE_ENV=production node src/index.js"
  },
  "dependencies": {
    "@clack/prompts": "^1.7.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/multipart": "^9.4.0",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.3",
    "bcrypt": "^5.1.1",
    "bcryptjs": "^3.0.3",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "fastify": "^5.8.2",
    "fastify-raw-body": "6.0.1",
    "figlet": "^1.8.0",
    "firebase-admin": "^14.0.0",
    "image-type": "^6.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^7.1.0",
    "ora": "^5.4.1",
    "resend": "^6.12.2",
    "sharp": "^0.35.3",
    "speakeasy": "^2.0.0",
    "ws": "^8.19.0"
  },
  "overrides": {
    "tar": "^7.5.22",
    "uuid": "^11.1.1"
  }
}
